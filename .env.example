# ===== LitPulse 配置模板 =====
# 复制本文件为 .env，填入你自己的值；.env 不会被提交到 Git（已在 .gitignore 忽略）。

# 任意兼容 OpenAI 接口的模型服务都可以，下面以 DeepSeek 为例：
LITPULSE_API_KEY=sk-在这里填你的key
LITPULSE_BASE_URL=https://api.deepseek.com/v1
LITPULSE_MODEL=deepseek-chat

# 也兼容标准 OpenAI 环境变量名：
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
